{
	"name": "kqm-sim-database",
	"account_id": "c102bcadcefa0897a01701fd28bed543",
	"main": "worker/index.mjs",
	"compatibility_date": "2026-09-12",
	"workers_dev": true,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kqm-sim-database",
			"database_id": "ecbe003b-158b-4b47-90d6-83f596eb4179",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "kqm-sim-database" }],
	"ratelimits": [
		{
			"name": "SUBMISSION_LIMITER",
			"namespace_id": "2026092201",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"triggers": { "crons": ["*/5 * * * *"] },
	"routes": [{ "pattern": "db.kqm.gg", "custom_domain": true }],
	"observability": { "enabled": true }
}
